# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local database — user accounts and encrypted wallet keys, never commit
/data/

# scratch
*.log

# local test cookie jars
ck*.txt
.prod-encryption-key.backup.txt


# local API test scratch
exec.json
r*.json
resp.json
page.html
X-THREAD.md

# local AI tooling — never publish
.claude/
CLAUDE.md
AGENTS.md

# Bot wallet secrets — these hold pooled user capital. NEVER commit.
.bot-wallets.backup.txt
.arena-encryption-key.backup.txt

# Database backups — contain encrypted wallet keys. Never commit.
/backups/
