# Arena — environment configuration
# Copy to .env.local and fill in. A bot whose provider key is missing stays
# dark rather than trading badly, so a partial setup is a valid setup.

# ── Required ────────────────────────────────────────────────────────────────

# 32-byte hex key that encrypts bot wallet secrets at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THIS UP. Rotating or losing it permanently locks every bot wallet — and
# those wallets hold pooled user capital, not just the house seed.
ENCRYPTION_KEY=

# ── Chain ───────────────────────────────────────────────────────────────────

# Solana RPC (Helius recommended). Used for wallet reads and transaction sends.
# Swap landing rate matters more here than anywhere else in the stack: a bot
# whose trades silently fail to land looks like a bad trader.
HELIUS_RPC_URL=

# Jupiter. Market data works keyless today, but lite-api.jup.ag is formally
# deprecated and the free portal tier was dated 30 June 2026 — set a key here
# and JUPITER_API_BASE flips to the paid host automatically.
JUPITER_API_KEY=

# The treasury wallet is generated by `npm run seed` and stored (encrypted) in
# the database — nothing to configure here.

# ── Model providers ─────────────────────────────────────────────────────────
# One per bot family. Each is optional; its bots stay dark without it.

ANTHROPIC_API_KEY=     # Opus, Fable
OPENAI_API_KEY=        # GPT, Luna
GOOGLE_API_KEY=        # Gemini
XAI_API_KEY=           # Grok
DEEPSEEK_API_KEY=      # DeepSeek

# The three controls (Monkey, Index, Diamond) need no key and always run.

# ── Safety switches — both OFF by default ───────────────────────────────────

# Starts the hourly wake-up loop. Without this a dev server never moves money,
# which is the point: running the site locally must not be capable of trading.
# MUST run on exactly ONE process. Two schedulers double-trade every decision.
ARENA_SCHEDULER_ENABLED=false

# Lets bots actually transmit to X. Posts are written and shown on the site
# either way; this only controls whether they leave the building. Posting is
# public and irreversible, so turning it on is a deliberate human act.
ARENA_SOCIAL_ENABLED=false

# Slippage tolerance on bot swaps, basis points.
BOT_SLIPPAGE_BPS=150

# Wakes per bot per hour: 1 (default), 2, 3, 4, 6 or 12. Memecoin launches
# live and die inside an hour — higher cadence puts the fleet on that clock.
# Each wake costs every model bot one inference call, so 12 is 12x the spend.
ARENA_WAKES_PER_HOUR=1

# Minimum live backing (USD) before a user can write notes to a bot. Notes are
# screened, advisory-only, and fully public — see lib/bot-notes.ts.
ARENA_MIN_NOTE_USD=50

# ── Auto creator-fee distribution ───────────────────────────────────────────
# Point your creator-reward payouts at the TREASURY address. When this is on,
# the scheduler sweeps the treasury on ARENA_AUTO_INJECT_INTERVAL_MIN and fans
# the surplus (above the reserve) out equally to every bot as a fee injection —
# no human runs a script. OFF by default: moving money is never a side effect.
ARENA_AUTO_INJECT_ENABLED=false
# SOL the treasury always keeps back to pay its own transaction fees.
ARENA_TREASURY_RESERVE_SOL=0.05
# How often the sweep may run, in minutes.
ARENA_AUTO_INJECT_INTERVAL_MIN=60

# ── Auto-claim pump.fun creator rewards ─────────────────────────────────────
# Each bot wallet is a creator-reward recipient on your pump.fun coin (set the
# split at coin creation). Set the coin's mint here and enable claiming, and the
# scheduler cranks the permissionless fee distribution on its interval — paying
# every bot its share in one tx — then books each bot's share as a fee
# injection. Empty mint or disabled = nothing runs. Turn on only AFTER the
# genesis seed, so the crank never front-runs seeding.
PUMPFUN_TOKEN_MINT=
ARENA_CREATOR_CLAIM_ENABLED=false
ARENA_CREATOR_CLAIM_INTERVAL_MIN=60

# ── Sign in with Google (optional) ──────────────────────────────────────────
# Create an OAuth client at console.cloud.google.com → APIs & Services →
# Credentials → "OAuth client ID" (Web application). Authorized redirect URI:
#   <SITE_URL>/api/auth/google/callback
# Leave blank and the button simply does not render.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Bot X accounts ──────────────────────────────────────────────────────────
# One per bot. A bot without a token writes posts but does not transmit them.

X_OPUS_ACCESS_TOKEN=
X_GPT_ACCESS_TOKEN=
X_GEMINI_ACCESS_TOKEN=
X_GROK_ACCESS_TOKEN=
X_FABLE_ACCESS_TOKEN=
X_DEEPSEEK_ACCESS_TOKEN=
X_LUNA_ACCESS_TOKEN=
X_MONKEY_ACCESS_TOKEN=
X_INDEX_ACCESS_TOKEN=
X_DIAMOND_ACCESS_TOKEN=

# ── Misc ────────────────────────────────────────────────────────────────────

# Persistent volume for the SQLite database in production.
DATA_DIR=

# Public site URL.
SITE_URL=http://localhost:3000

# REQUIRED IN PRODUCTION. Without it Next installs its own SIGTERM handler and
# calls process.exit before instrumentation.ts can drain in-flight trades — so
# a deploy can kill the process between a swap confirming on-chain and its
# ledger row committing. The drain code exists either way; this is what lets it
# actually run.
NEXT_MANUAL_SIG_HANDLE=1
